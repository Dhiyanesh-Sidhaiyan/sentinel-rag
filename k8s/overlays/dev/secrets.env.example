# Copy to secrets.env (git-ignored) and fill in. Generate values with:
#   python -c "import secrets;print(secrets.token_urlsafe(24))"
POSTGRES_PASSWORD=<random>
POSTGRES_DSN=postgresql://sentinel:<same-random>@postgres:5432/sentinel
REDIS_URL=redis://valkey:6379/0
QDRANT_API_KEY=<random>
# {"<sha256 of api key>": "<tenant>"}  -- use scripts/gen_api_key.py and copy the value from .env
API_KEYS_SHA256={}
