# Copy to .env (git-ignored). `make dev-key` generates an API key and fills API_KEYS_SHA256 for you.
ENVIRONMENT=local
LOG_LEVEL=INFO
LOG_JSON=true

# --- backends: memory (zero-dependency) | qdrant / postgres / redis (docker compose sets these) ---
VECTOR_BACKEND=memory
GRAPH_BACKEND=memory
CACHE_BACKEND=memory
QDRANT_URL=http://localhost:6333
# POSTGRES_DSN=postgresql://sentinel:<password>@localhost:5432/sentinel
# REDIS_URL=redis://localhost:6379/0

# --- models: "offline" runs fully local & deterministic. "openai" = any OpenAI-compatible endpoint ---
LLM_PROVIDER=offline
EMBEDDING_PROVIDER=hash
EMBEDDING_DIM=512
# LLM_BASE_URL=https://your-llm-gateway.internal/v1
# LLM_API_KEY=   <- inject from a secret manager; never commit
# LLM_MODEL=gpt-4o-mini
# EMBEDDING_MODEL=text-embedding-3-small

# --- security ---
AUTH_ENABLED=true
# JSON object: {"<sha256 of api key>": "<tenant id>"}
API_KEYS_SHA256={}
RATE_LIMIT_PER_MINUTE=60
